@article{sfinite_kernel_rocq,
author = {Affeldt, Reynald and Cohen, Cyril and Saito, Ayumu},
title = {Semantics of Probabilistic Programs Using s-Finite Kernels in Dependent Type Theory},
year = {2025},
issue_date = {September 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {1},
number = {3},
url = {https://doi.org/10.1145/3732291},
doi = {10.1145/3732291},
abstract = {Probabilistic programming languages are used to write probabilistic models to make probabilistic inferences. A number of rigorous semantics have been developed to reason about transformations of probabilistic programs and their execution. We propose to investigate the formalization of such a semantics to allow for the formal verification of probabilistic programs. Concretely, we extend an existing formalization of measure and integration theory in the Rocq prover, a proof assistant based on dependent type theory, with s-finite kernels, a mathematical structure to interpret typing judgments in the semantics of a probabilistic programming language. We explain the issues raised by organizing kernels as a hierarchy of mathematical structures and use the latter to formalize the semantics of a first-order probabilistic programming language. We use this semantics to establish generic properties of this language, prove rewriting laws to perform symbolic evaluation, and reason about iteration.},
journal = {ACM Trans. Probab. Mach. Learn.},
month = aug,
articleno = {16},
numpages = {34},
keywords = {Rocq, measure theory, integration theory, probabilistic programming language}
}

